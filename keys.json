{
  "global": {
    "ctrl-b": "mod.open:prefix",
    "cmd-=": "mod.open:text-bigger",
    "cmd-+": "mod.open:text-bigger",
    "cmd--": "mod.open:text-smaller"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "cmd-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "cmd-v": "terminal.paste",
    "ctrl-shift-f": "terminal.search",
    "ctrl-v": "terminal.paste_image",
    "ctrl-insert": "terminal.copy",
    "shift-insert": "terminal.paste",
    "ctrl-[": "send:\u001b"
  },
  "mod:prefix": {
    "c": "prefix.tab.new",
    "n": "prefix.tab.next",
    "p": "prefix.tab.prev",
    "1": "prefix.tab.select:1",
    "2": "prefix.tab.select:2",
    "3": "prefix.tab.select:3",
    "4": "prefix.tab.select:4",
    "5": "prefix.tab.select:5",
    "6": "prefix.tab.select:6",
    "7": "prefix.tab.select:7",
    "8": "prefix.tab.select:8",
    "9": "prefix.tab.select:9",
    "shift-t": "prefix.tab.rename",
    "shift-x": "prefix.tab.close",
    "shift-n": "prefix.space.new",
    "shift-w": "prefix.space.rename",
    "shift-d": "prefix.space.close",
    "shift-g": "prefix.worktree",
    "w": "prefix.navigate",
    "m": "prefix.ram.meta",
    "i": "prefix.ram.space",
    "r": "prefix.ram.hunk",
    "g": "prefix.lazygit",
    "f": "prefix.ram.follow",
    "d": "prefix.ram.changes",
    "h": "prefix.pane.go:left",
    "shift-h": "prefix.pane.swap:left",
    "j": "prefix.pane.go:down",
    "shift-j": "prefix.pane.swap:down",
    "k": "prefix.pane.go:up",
    "shift-k": "prefix.pane.swap:up",
    "l": "prefix.pane.go:right",
    "shift-l": "prefix.pane.swap:right",
    "v": "prefix.pane.split:right",
    "-": "prefix.pane.split:down",
    "x": "prefix.pane.close",
    "z": "prefix.pane.zoom",
    "b": "prefix.layout.toggle:sidebar",
    "(": "prefix.space.prev",
    "shift-9": "prefix.space.prev",
    ")": "prefix.space.next",
    "shift-0": "prefix.space.next",
    "a": "prefix.agent.next",
    "shift-a": "prefix.agent.prev",
    ":": "prefix.app.palette",
    "shift-;": "prefix.app.palette",
    "space": "prefix.layout.switch",
    "s": "prefix.app.settings",
    "?": "prefix.app.help",
    "shift-/": "prefix.app.help",
    "+": "prefix.app.zoom_in",
    "shift-=": "prefix.app.zoom_in",
    "_": "prefix.app.zoom_out",
    "shift--": "prefix.app.zoom_out",
    "0": "prefix.app.zoom_reset",
    "ctrl-b": "prefix.passthrough"
  }
}
