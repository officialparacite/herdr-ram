{
  "global": {
    "ctrl-b": "mod.open:ram-prefix",
    "cmd-=": "mod.open:ram-text-bigger",
    "cmd-+": "mod.open:ram-text-bigger",
    "cmd--": "mod.open:ram-text-smaller"
  },
  "mod:ram-prefix": {
    "c": "ram-prefix.tab.new",
    "n": "ram-prefix.tab.next",
    "p": "ram-prefix.tab.prev",
    "1": "ram-prefix.tab.select:1",
    "2": "ram-prefix.tab.select:2",
    "3": "ram-prefix.tab.select:3",
    "4": "ram-prefix.tab.select:4",
    "5": "ram-prefix.tab.select:5",
    "6": "ram-prefix.tab.select:6",
    "7": "ram-prefix.tab.select:7",
    "8": "ram-prefix.tab.select:8",
    "9": "ram-prefix.tab.select:9",
    "shift-t": "ram-prefix.tab.rename",
    "shift-x": "ram-prefix.tab.close",
    "shift-n": "ram-prefix.space.new",
    "shift-w": "ram-prefix.space.rename",
    "shift-d": "ram-prefix.space.close",
    "shift-g": "ram-prefix.worktree",
    "w": "ram-prefix.navigate",
    "m": "ram-prefix.ram.meta",
    "i": "ram-prefix.ram.space",
    "r": "ram-prefix.ram.hunk",
    "g": "ram-prefix.lazygit",
    "f": "ram-prefix.ram.follow",
    "d": "ram-prefix.ram.changes",
    "h": "ram-prefix.pane.go:left",
    "shift-h": "ram-prefix.pane.swap:left",
    "j": "ram-prefix.pane.go:down",
    "shift-j": "ram-prefix.pane.swap:down",
    "k": "ram-prefix.pane.go:up",
    "shift-k": "ram-prefix.pane.swap:up",
    "l": "ram-prefix.pane.go:right",
    "shift-l": "ram-prefix.pane.swap:right",
    "v": "ram-prefix.pane.split:right",
    "-": "ram-prefix.pane.split:down",
    "x": "ram-prefix.pane.close",
    "z": "ram-prefix.pane.zoom",
    "b": "ram-prefix.layout.toggle:sidebar",
    "(": "ram-prefix.space.prev",
    "shift-9": "ram-prefix.space.prev",
    ")": "ram-prefix.space.next",
    "shift-0": "ram-prefix.space.next",
    "a": "ram-prefix.agent.next",
    "shift-a": "ram-prefix.agent.prev",
    ":": "ram-prefix.app.palette",
    "shift-;": "ram-prefix.app.palette",
    "space": "ram-prefix.layout.switch",
    "s": "ram-prefix.app.settings",
    "?": "ram-prefix.app.help",
    "shift-/": "ram-prefix.app.help",
    "+": "ram-prefix.app.zoom_in",
    "shift-=": "ram-prefix.app.zoom_in",
    "_": "ram-prefix.app.zoom_out",
    "shift--": "ram-prefix.app.zoom_out",
    "0": "ram-prefix.app.zoom_reset",
    "ctrl-b": "ram-prefix.passthrough"
  }
}
