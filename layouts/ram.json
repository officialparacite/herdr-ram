      "min": 150,
      "gap": 10,
      "padding": [
        8,
        12
      ],
      "resizable": true,
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "size": {
            "px": 340
          },
          "min": 240,
          "content": {
            "mod": "ram",
            "props": {
              "role": "side"
            }
          }
        },
        {
          "id": "ram-main",
          "type": "column",
          "size": {
            "weight": 1
          },
          "gap": 8,
          "resizable": false,
          "children": [
            {
              "id": "ram-terminals",
