                  "focus": {
                    "width": 1,
                    "color": "#ffb547"
                  }
                }
              }
            },
            {
              "id": "ram-rams",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 168,
              "hidden": true,
              "content": {
                "mod": "ram",
                "props": {
                  "role": "rams"
                }
              }
            },
            {
              "id": "ram-peek",
              "type": "block",
              "size": {
                "px": 180
              },
              "hidden": true,
              "content": {
                "mod": "ram",
                "props": {
                  "role": "peek"
                }
              }
            }
          ]
        }
